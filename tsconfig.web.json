{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/preload/index.ts",
    "test-data/**/*.ts"
  ],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "paths": {
      "@renderer/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@preload/*": ["./src/preload/*"],
      "@fixtures/*": ["./test-data/*"]
    }
  }
}
