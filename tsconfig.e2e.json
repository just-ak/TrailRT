{
  "extends": "./tsconfig.base.json",
  "include": [
    "tests/**/*",
    "playwright.config.ts",
    "src/renderer/types/global.d.ts",
    "src/shared/**/*",
    "test-data/**/*.ts"
  ],
  "compilerOptions": {
    // End-to-end specs run in Node, but `page.evaluate` callbacks are
    // serialised into the renderer, so their bodies need DOM types.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@fixtures/*": ["./test-data/*"]
    }
  }
}
