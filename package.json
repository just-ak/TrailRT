{
  "name": "trailrt",
  "version": "0.1.0",
  "private": true,
  "description": "A modern desktop replacement for Garmin BaseCamp. Local-first trip, route, track and waypoint planning.",
  "license": "GPL-3.0-or-later",
  "author": "TrailRT contributors",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "handbook": "handbook",
    "handbook:build": "handbook build",
    "handbook:validate": "handbook validate",
    "handbook:index": "handbook index",
    "handbook:changes": "handbook changes",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "package": "npm run build && electron-builder --mac && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "verify:native": "electron scripts/verify-native.mjs",
    "build:valhalla": "bash scripts/build-valhalla.sh",
    "verify:valhalla": "electron scripts/verify-valhalla.mjs",
    "licences": "node scripts/generate-licences.mjs",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "licences:check": "node scripts/generate-licences.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "verify:valhalla:remote": "TRAILRT_LIVE_VALHALLA=${TRAILRT_LIVE_VALHALLA:-https://valhalla1.openstreetmap.de} vitest run src/main/routing/valhalla.live.test.ts",
    "verify:geofabrik": "TRAILRT_LIVE_GEOFABRIK=1 vitest run src/main/routing/geofabrik.live.test.ts",
    "verify:shaping": "TRAILRT_LIVE_EMBEDDED=${TRAILRT_LIVE_EMBEDDED:-1} vitest run src/main/routing/shaping.live.test.ts",
    "verify:regions": "TRAILRT_LIVE_REGIONS=1 vitest run src/main/routing/regions.live.test.ts",
    "verify:search": "vitest run src/main/places/search.live.test.ts"
  },
  "dependencies": {
    "@just-ak/kiro-spec-handbook": "^0.5.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fit-file-parser": "^6.2.7",
    "jszip": "^3.10.2",
    "lucide-react": "1.72.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "leaflet": "1.9.4",
    "oxlint": "1.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "electron-winstaller": false,
    "fsevents@2.3.3": true
  }
}
